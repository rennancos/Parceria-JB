{
  "name": "pa-jb-portal",
  "version": "1.1.0",
  "private": true,
  "description": "Portal interno da Parceria JB. O site é estático e abre sem build; servidor/ é um processo Node opcional que serve a mesma pasta e responde à API de edição pela própria página.",
  "main": "app/principal.js",
  "scripts": {
    "test": "node --test tests/unit/*.test.cjs",
    "test:browser": "node --test tests/browser.cjs",
    "dev": "serve --listen 8000 .",
    "start": "serve --listen 8000 .",
    "servidor": "node servidor/servidor.js",
    "usuarios": "node servidor/usuarios.js",
    "app": "electron .",
    "app:build": "node app/empacotar.js",
    "app:manifesto": "node app/manifesto.js",
    "app:teste": "electron app/teste-atualizacao.js",
    "fotos": "node ferramentas/otimizar-fotos.js",
    "icone": "node ferramentas/gerar-icone.js"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.0",
    "serve": "^14.2.4"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.7",
      "@xmldom/xmldom": "^0.8.15"
    }
  }
}
